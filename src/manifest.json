{
	"manifest_version": 3,
	"name": "Audio Change",
	"description": "修改网页音量且管理标签",
	"version": "1.0.0",
	"icons": {
		"48": "assets/icon_48.png",
		"128": "assets/icon_128.png"
	},
	"action": {
		"default_icon": {
			"19": "assets/icon_19.png",
			"38": "assets/icon_38.png"
		},
		"default_popup": "popup.html",
		"default_title": "Audio Change"
	},
	"background": {
		"service_worker": "js/background.js",
		"type": "module"
	},
	"content_scripts": [{
		"matches": [
			"http://*/*",
			"https://*/*"
		],
		"js": [
			"js/content.js"
		],
		"run_at": "document_end"
	}],
	"permissions": [
		"tabs", "tabCapture",
		"activeTab", "nativeMessaging", "scripting", "offscreen", "storage"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	]
}
